{
  "name": "agents-huddle",
  "productName": "Agents Huddle",
  "version": "0.1.0",
  "description": "A corner widget that shows what each Claude Code agent is doing and lets you approve or answer without opening the editor",
  "private": true,
  "license": "MIT",
  "author": "Yasir",
  "repository": {
    "type": "git",
    "url": "https://github.com/yasirldn/agents-huddle-for-claude-code.git"
  },
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test",
    "hooks": "node scripts/hooks.mjs",
    "icons": "node scripts/make-icons.mjs",
    "package": "electron-packager . \"Agents Huddle\" --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/icon.ico --tmpdir=.packager-tmp --ignore=\"^/(\\.scratch|\\.packager-tmp|test|dist|dist-store|build|docs|scripts)($|/)\" --ignore=\"^/node_modules/lucide-static/(dist|font|sprite\\.svg|icon-nodes\\.json|tags\\.json)\" --ignore=\"^/node_modules/@fontsource-variable/[^/]+/files/(?!.*latin-wght-normal\\.woff2$)\"",
    "store": "node scripts/store.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "htm": "^3.1.1",
    "lucide-static": "^1.78.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.yasirldn.agentshuddle",
    "productName": "Agents Huddle",
    "directories": {
      "output": "dist-store",
      "buildResources": "build"
    },
    "win": {
      "target": "appx"
    },
    "appx": {
      "applicationId": "AgentsHuddle",
      "displayName": "Agents Huddle",
      "identityName": "AgentsHuddle.Test",
      "publisher": "CN=AgentsHuddleTest",
      "publisherDisplayName": "Yasir",
      "backgroundColor": "#141415",
      "languages": [
        "en-GB"
      ]
    }
  }
}
